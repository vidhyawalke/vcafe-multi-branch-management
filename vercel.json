{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "path": "client",
      "framework": "vite"
    },
    "server": {
      "path": "server",
      "framework": "express"
    }
  },
  "routes": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
